{
  "name": "quote-approval-receipt",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "cargo run",
    "test": "npm run test:claims-manifest && npm run build && cargo test && npm run test:runtime-contract && npm run test:replica-split && npm run test:durable-snapshot && playwright test",
    "test:claims-manifest": "node tests/claims-manifest.mjs",
    "test:runtime-contract": "cargo build --release && node tests/runtime-contract.mjs",
    "test:replica-split": "cargo build --release && node tests/replica-split.mjs",
    "test:durable-snapshot": "cargo build --release && node tests/durable-snapshot.mjs",
    "test:live-demo": "node scripts/live-demo-check.mjs",
    "test:live-rate-limit": "node scripts/live-rate-limit-check.mjs",
    "test:live-topology": "node scripts/live-topology-check.mjs",
    "test:live-review": "node scripts/live-review-check.mjs",
    "test:ui": "playwright test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "pdfjs-dist": "^5.4.296",
    "typescript": "5.7.3",
    "vite": "^8.2.2"
  }
}
