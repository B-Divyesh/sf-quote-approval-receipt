{
  "name": "quote-approval-receipt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "cargo run",
    "test": "npm run build && cargo test && npm run test:runtime-contract && npm run test:durable-snapshot && playwright test",
    "test:runtime-contract": "cargo build --release && node tests/runtime-contract.mjs",
    "test:durable-snapshot": "node tests/durable-snapshot.mjs",
    "test:ui": "playwright test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "pdfjs-dist": "^5.4.296",
    "typescript": "5.7.3",
    "vite": "^8.2.2"
  }
}
